					"const tokenExpiry = pm.environment.get(\"access_token_expiry\");\r",
					"const now = Math.floor(Date.now() / 1000);\r",
					"\r",
					"if (!token || (tokenExpiry && now >= tokenExpiry)) {\r",
					"    console.log(\"Access token missing or expired.\");\r",
					"    postman.setNextRequest(\"Auth - Login\"); // must match your login request name\r",
					"}\r",
