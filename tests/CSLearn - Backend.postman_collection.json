			"name": "Auth - Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {\r",
							"    const json = pm.response.json();\r",
							"    pm.environment.set(\"access_token\", json.access_token);\r",
							"    const ttlSeconds = 3600; // 1 hour\r",
							"    const now = Math.floor(Date.now() / 1000);\r",
							"    pm.environment.set(\"access_token_expiry\", now + ttlSeconds);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"yourUser\",\r\n  \"password\": \"yourPass\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8080/api/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
